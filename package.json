{
  "name": "jotbox",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "npm run test:web && npm run test:server",
    "test:web": "npm run test -w @jotbox/web",
    "test:server": "node --test tests/ai.test.mjs tests/memory.test.mjs tests/billing.test.mjs tests/usage.test.mjs tests/db.test.mjs",
    "dev:web": "npm run dev -w @jotbox/web",
    "build:web": "npm run build -w @jotbox/web",
    "preview:web": "npm run preview -w @jotbox/web",
    "db:migrate": "node db/migrate.mjs",
    "db:check": "node db/check.mjs",
    "db:role": "node db/setup-role.mjs",
    "ai:check": "node --env-file=.env scripts/ai-check.mjs",
    "ai:test": "node --env-file=.env scripts/ai-check.mjs --test",
    "ai:demo": "node --env-file=.env scripts/ai-check.mjs --mock --test",
    "ai:sample": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-sample-audio.ps1 -Out .shots/ai-sample.wav",
    "eval:setup": "python -m venv eval/.venv && node eval/py.mjs -m pip install -r eval/requirements.txt",
    "eval:run": "node --env-file-if-exists=.env eval/run_pipeline.mjs",
    "eval:glossary": "node --env-file-if-exists=.env eval/run_pipeline.mjs --glossary",
    "eval:normalize": "node --env-file-if-exists=.env eval/run_pipeline.mjs --normalize",
    "eval:score": "node eval/py.mjs eval/score.py",
    "eval:check": "node eval/py.mjs eval/score.py --check",
    "eval:check:full": "node eval/py.mjs eval/score.py --judge --check --require-brief",
    "eval:test": "node eval/py.mjs eval/score.py --self-test",
    "eval:demo": "node eval/py.mjs eval/score.py --manifest eval/fixtures/manifest.json --predictions eval/fixtures/predictions.json --judge-mock --out .shots/eval-demo",
    "eval:smoke": "node eval/run_pipeline.mjs --mock --manifest eval/fixtures/manifest.json --out .shots/eval-smoke --no-notes"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "npm@10.8.0",
  "dependencies": {
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
