{
  "name": "jotbox",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev:web": "npm run dev -w @jotbox/web",
    "build:web": "npm run build -w @jotbox/web",
    "preview:web": "npm run preview -w @jotbox/web",
    "db:migrate": "node db/migrate.mjs",
    "db:check": "node db/check.mjs",
    "db:role": "node db/setup-role.mjs",
    "ai:check": "node --env-file=.env scripts/ai-check.mjs",
    "ai:test": "node --env-file=.env scripts/ai-check.mjs --test",
    "ai:demo": "node --env-file=.env scripts/ai-check.mjs --mock --test",
    "ai:sample": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-sample-audio.ps1 -Out .shots/ai-sample.wav"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "npm@10.8.0",
  "dependencies": {
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
