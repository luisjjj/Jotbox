{
  "name": "jotbox",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "npm run test:web && npm run test:server",
    "test:web": "npm run test -w @jotbox/web",
    "test:server": "node --test tests/ai.test.mjs tests/memory.test.mjs tests/billing.test.mjs tests/usage.test.mjs tests/db.test.mjs",
    "dev:web": "npm run dev -w @jotbox/web",
    "build:web": "npm run build -w @jotbox/web",
    "preview:web": "npm run preview -w @jotbox/web",
    "db:migrate": "node db/migrate.mjs",
    "db:check": "node db/check.mjs",
    "db:role": "node db/setup-role.mjs",
    "ai:check": "node --env-file=.env scripts/ai-check.mjs",
    "ai:test": "node --env-file=.env scripts/ai-check.mjs --test",
    "ai:demo": "node --env-file=.env scripts/ai-check.mjs --mock --test",
    "ai:sample": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-sample-audio.ps1 -Out .shots/ai-sample.wav",
    "eval:setup": "python -m venv eval/.venv && node eval/py.mjs -m pip install -r eval/requirements.txt",
    "eval:run": "node --env-file-if-exists=.env eval/run_pipeline.mjs",
    "eval:glossary": "node --env-file-if-exists=.env eval/run_pipeline.mjs --glossary",
    "eval:normalize": "node --env-file-if-exists=.env eval/run_pipeline.mjs --normalize",
    "eval:score": "node eval/py.mjs eval/score.py",
    "eval:check": "node eval/py.mjs eval/score.py --check",
    "eval:check:full": "node eval/py.mjs eval/score.py --judge --check --require-brief",
    "eval:test": "node eval/py.mjs eval/score.py --self-test",
    "eval:demo": "node eval/py.mjs eval/score.py --manifest eval/fixtures/manifest.json --predictions eval/fixtures/predictions.json --judge-mock --out .shots/eval-demo",
    "eval:smoke": "node eval/run_pipeline.mjs --mock --manifest eval/fixtures/manifest.json --out .shots/eval-smoke --no-notes",
    "eval:public:import": "node eval/py.mjs eval/import_pidgin_asr.py --split test --count 30",
    "eval:public:run": "node --env-file-if-exists=.env eval/run_pipeline.mjs --manifest eval/public/pidgin-asr/manifest.json --no-notes --pause 3200 --out eval/results/public-baseline",
    "eval:public:normalize": "node --env-file-if-exists=.env eval/run_pipeline.mjs --manifest eval/public/pidgin-asr/manifest.json --no-notes --normalize --pause 3200 --out eval/results/public-normalized",
    "eval:public:score": "node eval/py.mjs eval/score.py --manifest eval/public/pidgin-asr/manifest.json --predictions eval/results/public-baseline/predictions.json",
    "eval:public:score:normalized": "node eval/py.mjs eval/score.py --manifest eval/public/pidgin-asr/manifest.json --predictions eval/results/public-normalized/predictions.json",
    "eval:public:glossary": "node --env-file-if-exists=.env eval/run_pipeline.mjs --manifest eval/public/pidgin-asr/manifest.json --no-notes --pause 3200 --glossary --out eval/results/public-glossary",
    "eval:public:score:injected": "node eval/py.mjs eval/score.py --manifest eval/public/pidgin-asr/manifest.json --predictions eval/results/public-glossary/predictions.json",
    "eval:public:pidgin": "node --env-file-if-exists=.env eval/run_pipeline.mjs --manifest eval/public/pidgin-asr/manifest.json --no-notes --pause 3200 --prompt eval/prompts/pidgin.txt --out eval/results/public-pidgin-prompt",
    "eval:public:pidgin:glossary": "node --env-file-if-exists=.env eval/run_pipeline.mjs --manifest eval/public/pidgin-asr/manifest.json --no-notes --pause 3200 --prompt eval/prompts/pidgin.txt --glossary --out eval/results/public-pidgin-glossary",
    "eval:public:score:pidgin": "node eval/py.mjs eval/score.py --manifest eval/public/pidgin-asr/manifest.json --predictions eval/results/public-pidgin-prompt/predictions.json",
    "eval:public:score:pidgin:glossary": "node eval/py.mjs eval/score.py --manifest eval/public/pidgin-asr/manifest.json --predictions eval/results/public-pidgin-glossary/predictions.json",
    "eval:glossary:test": "node eval/py.mjs eval/glossary_match.py --self-test",
    "eval:glossary:apply": "node eval/py.mjs eval/glossary_match.py --predictions eval/results/public-pidgin-glossary/predictions.json --glossary eval/public/pidgin-asr/corrections.txt --out eval/results/public-pidgin-glossary/predictions.corrected.json",
    "eval:glossary:apply:words": "node eval/py.mjs eval/glossary_match.py --predictions eval/results/public-pidgin-glossary/predictions.json --glossary eval/public/pidgin-asr/corrections.txt --restore-words --out eval/results/public-pidgin-glossary/predictions.corrected-words.json",
    "eval:public:score:glossary": "node eval/py.mjs eval/score.py --manifest eval/public/pidgin-asr/manifest.json --predictions eval/results/public-pidgin-glossary/predictions.corrected.json",
    "eval:public:score:glossary:words": "node eval/py.mjs eval/score.py --manifest eval/public/pidgin-asr/manifest.json --predictions eval/results/public-pidgin-glossary/predictions.corrected-words.json"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "npm@10.8.0",
  "dependencies": {
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
