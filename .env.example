# Server-only environment. Never prefix these with VITE_.
# Runtime connection: least-privilege application role.
DATABASE_URL=postgresql://jotbox_app:password@host/neondb?sslmode=require
# Owner connection: migrations and role setup only.
DATABASE_URL_OWNER=postgresql://neondb_owner:password@host/neondb?sslmode=require
# Generated by `node db/setup-role.mjs`; keep it with the owner secret.
APP_DB_PASSWORD=

# ---- Reading recordings and writing notes (free-first) ----
# ElevenLabs Scribe v3 returns a diarised transcript with speaker ids. When
# this key is set it reads full recordings first. Pidgin is sent without a
# language code because Scribe does not list it, so it auto-detects the mix.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v3
# Extra names, acronyms and product terms for Scribe key prompting. The room
# roster and JOTBOX_STT_VOCAB are added automatically.
JOTBOX_STT_KEYTERMS=
# Pin the reader order, for example "groq,elevenlabs" or "elevenlabs". Live
# captions stay on Groq turbo unless elevenlabs is placed first.
JOTBOX_STT_PROVIDER=

# Groq free tier: whisper-large-v3 reads accented, faint and fast speech
# better than turbo. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
# Live captions are a throwaway preview, so the cheaper turbo model is fine
# there and roughly halves the audio-seconds the previews burn.
GROQ_LIVE_STT_MODEL=whisper-large-v3-turbo
GROQ_NOTES_MODEL=openai/gpt-oss-120b

# Optional second free notes provider. https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_NOTES_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Long recordings: a self-hosted Speaches / faster-whisper worker.
# See docs/ai-providers.md and worker/docker-compose.yml.
WHISPER_BASE_URL=
WHISPER_API_KEY=
WHISPER_MODEL=Systran/faster-whisper-small

# Optional premium fallback.
XAI_API_KEY=
XAI_STT_MODEL=grok-voice-transcribe-2.0
XAI_NOTES_MODEL=grok-4.7

# ---- Payments (Paystack) ----
# Server-only secret. Use sk_test_... while testing and sk_live_... in production.
PAYSTACK_SECRET_KEY=
# Not used. Checkout is a server-created redirect, so no public key is needed.
PAYSTACK_PUBLIC_KEY=
# Optional existing monthly NGN plan. Leave blank to create and cache one.
PAYSTACK_PLAN_CODE=
# Naira charged for Pro each month. Default is $5 at JOTBOX_USD_TO_NGN.
PAYSTACK_PRO_AMOUNT_NGN=8000
JOTBOX_USD_TO_NGN=1600
# Listening each calendar month. Free defaults to 100 minutes, Pro to 25 hours,
# and Enterprise to a hidden 1000 hours shown in the app as unlimited.
JOTBOX_FREE_MONTH_MINUTES=100
JOTBOX_PRO_MONTH_HOURS=25
JOTBOX_ENTERPRISE_MONTH_HOURS=1000
# Set the Paystack webhook to https://your-domain/api/billing
# Callbacks return to /account?billing=callback automatically.
# Vercel Cron sends this bearer token to the daily payment check.
CRON_SECRET=

# ---- Transactional email (Sendly) ----
# Welcome, password reset, password changed, receipt, renewal reminder,
# cancellation, partner invite and founder note emails. Without a key they
# print to the server log.
SENDLY_API_KEY=
EMAIL_FROM=JotBox <hello@jotbox.online>
# Reply-to for founder check-ins sent with `npm run founder:mail`.
FOUNDER_EMAIL=
# Signature name used in the founder check-in email.
FOUNDER_NAME=
# Used for links in emails. Defaults to https://jotbox.online.
JOTBOX_PUBLIC_URL=https://jotbox.online

# ---- Audio retention (Cloudflare R2 or any S3-compatible bucket) ----
# Private bucket. Recordings are played through short-lived presigned links and
# removed after the retention window. Leave blank to keep audio on the device.
# Long recordings upload straight from the browser with a signed PUT. Add a
# bucket CORS rule for the app origin: PUT and GET, headers content-type,
# exposed header content-length. Without it the app falls back to the smaller
# server upload path.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional for non-R2 providers, for example https://s3.eu-west-1.amazonaws.com
# R2_ENDPOINT=
# R2_REGION=auto
# Days to keep audio. 0 disables the sweep.
JOTBOX_AUDIO_RETENTION_DAYS=30

# ---- Organisation memory embeddings (optional) ----
# Adds vector search on top of the built-in keyword search. Any OpenAI-compatible
# embeddings endpoint works.
# JOTBOX_EMBEDDINGS_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# JOTBOX_EMBEDDINGS_MODEL=text-embedding-3-small
# JOTBOX_EMBEDDINGS_DIMENSIONS=1536

# ---- Connected apps (Google Calendar, Outlook, Jira) ----
# Encrypts stored OAuth tokens with AES-256-GCM. 32 bytes, base64 or hex.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATIONS_ENCRYPTION_KEY=
# Google Cloud OAuth client.
# Redirect URI: {JOTBOX_PUBLIC_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra app registration.
# Redirect URI: {JOTBOX_PUBLIC_URL}/api/integrations/outlook/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common, organisations, consumers, or a tenant id.
MICROSOFT_TENANT_ID=common
# Atlassian OAuth 2.0 (3LO) app.
# Callback URL: {JOTBOX_PUBLIC_URL}/api/integrations/jira/callback
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# Optional: raises the GitHub API limit for /api/download/windows.
GITHUB_TOKEN=

# Pidgin and tone. The app defaults to Nigerian Pidgin, English,
# Yoruba, Igbo and Hausa code-switching, with a warm-direct note voice.
# JOTBOX_AI_TONE=warm-direct
# en is correct for English and Nigerian Pidgin. Use auto only when a
# meeting is genuinely in another language. See docs/ai-providers.md.
# JOTBOX_STT_LANGUAGE=en
# Names, products, places and Pidgin spellings the room uses. Bias the
# decoder toward them; keep under 60 terms.
# JOTBOX_STT_VOCAB=JotBox, Ibadan, Abuja, GTBank, NIPOST, wetin dey
# Replace the built-in speech prompt only if you know why.
# JOTBOX_STT_PROMPT=
# Segment noise thresholds. Raise the first two to keep more faint speech;
# lower them to drop more room noise. See docs/ai-providers.md.
# JOTBOX_STT_NO_SPEECH=0.65
# JOTBOX_STT_LOGPROB=-1
# JOTBOX_STT_COMPRESSION=2.4
# Set to off only for a worker that rejects faster-whisper VAD fields.
# JOTBOX_STT_WORKER_TUNING=on

# Local demo only. Never enable in production.
# JOTBOX_AI_MOCK=1

# ---- Browser analytics (PostHog, public) ----
# These two are not server secrets. Vite compiles them into the JavaScript
# bundle, so never put a private key or a personal phx_ API key here.
# Leave both blank to disable analytics. Copy the project key from the
# PostHog project settings. Host is https://us.i.posthog.com for US Cloud,
# or https://eu.i.posthog.com for EU Cloud.
# VITE_POSTHOG_KEY=phc_your_project_key
# VITE_POSTHOG_HOST=https://us.i.posthog.com
