# Server-only environment. Never prefix these with VITE_.
# Runtime connection: least-privilege application role.
DATABASE_URL=postgresql://jotbox_app:password@host/neondb?sslmode=require
# Owner connection: migrations and role setup only.
DATABASE_URL_OWNER=postgresql://neondb_owner:password@host/neondb?sslmode=require
# Generated by `node db/setup-role.mjs`; keep it with the owner secret.
APP_DB_PASSWORD=

# ---- Reading recordings and writing notes (free-first) ----
# Groq free tier: whisper-large-v3 reads accented, faint and fast speech
# better than turbo. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
GROQ_NOTES_MODEL=openai/gpt-oss-120b

# Optional second free notes provider. https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_NOTES_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Long recordings: a self-hosted Speaches / faster-whisper worker.
# See docs/ai-providers.md and worker/docker-compose.yml.
WHISPER_BASE_URL=
WHISPER_API_KEY=
WHISPER_MODEL=Systran/faster-whisper-small

# Optional premium fallback.
XAI_API_KEY=
XAI_STT_MODEL=grok-voice-transcribe-2.0
XAI_NOTES_MODEL=grok-4.7

# ---- Payments (Paystack) ----
# Server-only secret. Use sk_test_... while testing and sk_live_... in production.
PAYSTACK_SECRET_KEY=
# Optional existing monthly NGN plan. Leave blank to create and cache one.
PAYSTACK_PLAN_CODE=
# Naira charged for Pro each month. Default is $7 at JOTBOX_USD_TO_NGN.
PAYSTACK_PRO_AMOUNT_NGN=11200
JOTBOX_USD_TO_NGN=1600
# Free listening each calendar month. Pro is unlimited. Default is 60.
JOTBOX_FREE_MONTH_MINUTES=60
# Set the Paystack webhook to https://your-domain/api/billing
# Callbacks return to /account?billing=callback automatically.
# Vercel Cron sends this bearer token to the daily payment check.
CRON_SECRET=

# Pidgin and tone. The app defaults to Nigerian Pidgin, English,
# Yoruba, Igbo and Hausa code-switching, with a warm-direct note voice.
# JOTBOX_AI_TONE=warm-direct
# en is correct for English and Nigerian Pidgin. Use auto only when a
# meeting is genuinely in another language. See docs/ai-providers.md.
# JOTBOX_STT_LANGUAGE=en
# Names, products, places and Pidgin spellings the room uses. Bias the
# decoder toward them; keep under 60 terms.
# JOTBOX_STT_VOCAB=JotBox, Ibadan, Abuja, GTBank, NIPOST, wetin dey
# Replace the built-in speech prompt only if you know why.
# JOTBOX_STT_PROMPT=
# Segment noise thresholds. Raise the first two to keep more faint speech;
# lower them to drop more room noise. See docs/ai-providers.md.
# JOTBOX_STT_NO_SPEECH=0.65
# JOTBOX_STT_LOGPROB=-1
# JOTBOX_STT_COMPRESSION=2.4
# Set to off only for a worker that rejects faster-whisper VAD fields.
# JOTBOX_STT_WORKER_TUNING=on
# JOTBOX_PUBLIC_URL=https://jotbox-eight.vercel.app

# Local demo only. Never enable in production.
# JOTBOX_AI_MOCK=1
